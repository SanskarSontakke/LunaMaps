# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# lunar map pipeline: keep binaries/baked imagery out of git, track only the manifest
data/raw/
work/
public/tiles/*
!public/tiles/manifest.json
public/cesium/
.venv/

# python caches produced by the pytest suite
__pycache__/
.pytest_cache/

# the shapefile parts load_records() extracts from the tracked gazetteer zip;
# regenerated on every pytest/labels run, never committed
tests/fixtures/moon_nomenclature_fixture/
